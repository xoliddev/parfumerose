# Dockerfile.bot - Telegram Bot (parfumerose)
# Koyeb build sozlamasi shu faylni ishlatadi (Dockerfile bilan bir xil).
# Eslatma: oddiy `Dockerfile` ham mavjud (Render / docker-compose uchun) — ikkalasi bir xil.

FROM python:3.11-slim

WORKDIR /app

# 1. Python kutubxonalarini o'rnatish
COPY requirements.txt .
RUN pip install --upgrade pip && pip install --no-cache-dir -r requirements.txt

# 2. FFmpeg + postgresql-client o'rnatish (audio convert uchun + kunlik backup uchun pg_dump)
RUN apt-get update && \
    apt-get install -y ffmpeg postgresql-client && \
    rm -rf /var/lib/apt/lists/*

# 3. Loyiha kodlarini nusxalash
COPY . .

# 4. Data papkasini yaratish
RUN mkdir -p /app/data

# 5. Botni ishga tushirish
CMD ["python", "bot.py"]
